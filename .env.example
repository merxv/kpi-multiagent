# Скопируйте в .env и при необходимости измените. Ключи и адреса не хранятся в коде.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=180
LLM_RETRIES=2

# Защита от зацикливания
MAX_STEPS=150
MAX_RUNTIME_SEC=1200
MAX_REVISIONS=1

# Размер задачи
MAX_GOALS=4
TASKS_PER_GOAL=2
CHUNK_CHARS=2500
MAX_CHUNKS=6
